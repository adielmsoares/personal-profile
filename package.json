    "react-i18next": "^15.5.2",
    "react-router": "^7.6.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@vitejs/plugin-react": "^5.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.8",
    "vite": "^7.0.0"
